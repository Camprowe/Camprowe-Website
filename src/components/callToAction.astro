---
import "../styles/global.css";
---

<section id="_cta_split_hero_buttons_v6_001" class="py-10 sm:py-24 bg-white dark:bg-neutral-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Full Width Image with Overlay Content -->
    <div class="relative rounded-md overflow-hidden" data-motion="card" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
      <!-- Background Image -->
      <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=1200&amp;auto=format&amp;fit=crop&amp;q=80" alt="Team collaboration" class="w-full h-[500px] lg:h-[450px] object-cover" data-motion="image" style="opacity: 1; transform: scale(1); filter: blur(0px);">
      
      <!-- Gradient Overlay -->
      <div class="absolute inset-0 bg-linear-to-r from-gray-900/95 via-gray-800/80 to-transparent"></div>
      
      <!-- Content -->
      <div class="absolute inset-0 flex items-center">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
          <div class="grid lg:grid-cols-2 gap-8 items-center">
            
            <!-- Left Content -->
            <div data-motion="hero" style="opacity: 1;">
                <span data-motion="badge" class="inline-flex items-center gap-2 text-amber-600 text-sm font-semibold tracking-widest uppercase mb-6" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
                    <?xml version="1.0" encoding="UTF-8"?><svg width="24px" height="24px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="currentColor"><path d="M17.5 17.5C20 21 23.9486 18.4151 23 15C21.5753 9.87113 20.8001 7.01556 20.3969 5.50793C20.1597 4.62136 19.3562 4 18.4384 4L5.56155 4C4.64382 4 3.844 4.62481 3.62085 5.515C2.7815 8.86349 2.0326 11.8016 1.14415 15C0.195501 18.4151 4.14415 21 6.64415 17.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M18 8.5L18.0111 8.51" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M16.49 7L16.5011 7.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M16.49 10L16.5011 10.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M15 8.5L15.0111 8.51" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M7 7V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M5.5 8.5H8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M8 16C9.10457 16 10 15.1046 10 14C10 12.8954 9.10457 12 8 12C6.89543 12 6 12.8954 6 14C6 15.1046 6.89543 16 8 16Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M16 16C17.1046 16 18 15.1046 18 14C18 12.8954 17.1046 12 16 12C14.8954 12 14 12.8954 14 14C14 15.1046 14.8954 16 16 16Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    Production / World
                </span>              
                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mt-4">
                    The actual Call to Action that needs to be atleast 2 line to look good.
                </h2>
            </div>
            
            <!-- Right Content -->
            <div class="lg:pl-8">
              <p class="text-amber-100 text-lg mb-8" data-animate="text" style="opacity: 1;">
                Text Description about the Call to Action Blah Blah Blah, Text Description about the Call to Action Blah Blah Blah, Text Description about the Call to Action Blah Blah Blah, Text Description about the Call to Action Blah Blah Blah
              </p>
              
              <div class="flex flex-col sm:flex-row gap-4">
                <a data-motion="button" href="#" class="px-8 py-3.5 bg-white hover:bg-amber-50 rounded-sm text-amber-700 font-semibold transition-colors text-center" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
                  Link 1
                </a>
                <a data-motion="button" href="#" class="px-8 py-3.5 border border-white/40 hover:bg-white/10 rounded-sm text-white font-semibold transition-colors text-center flex items-center justify-center gap-2" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
                  </svg>
                  Link 2 (Video)
                </a>
              </div>
            </div>
            
          </div>
        </div>
      </div>
    </div>
    
  </div>
</section>