---
import "../styles/global.css";
---
<section id="_hero_gourmet_restaurant_v6_001" class="relative h-200">
  <div class="absolute inset-0">
    <img data-motion="image" src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1920&amp;auto=format&amp;fit=crop&amp;q=80" alt="Fine dining" class="w-full h-full object-cover" style="opacity: 1; transform: scale(1); filter: blur(0px);">
    <div class="absolute inset-0 bg-linear-to-r from-slate-900/95 via-slate-900/60 to-transparent"></div>
  </div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 min-h-200 flex items-center">
    <div class="max-w-2xl py-10">
      <span data-motion="badge" class="inline-flex items-center gap-2 text-amber-400 text-sm font-semibold tracking-widest uppercase mb-6" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
        <?xml version="1.0" encoding="UTF-8"?><svg width="24px" height="24px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="currentColor"><path d="M17.5 17.5C20 21 23.9486 18.4151 23 15C21.5753 9.87113 20.8001 7.01556 20.3969 5.50793C20.1597 4.62136 19.3562 4 18.4384 4L5.56155 4C4.64382 4 3.844 4.62481 3.62085 5.515C2.7815 8.86349 2.0326 11.8016 1.14415 15C0.195501 18.4151 4.14415 21 6.64415 17.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M18 8.5L18.0111 8.51" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M16.49 7L16.5011 7.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M16.49 10L16.5011 10.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M15 8.5L15.0111 8.51" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M7 7V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M5.5 8.5H8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M8 16C9.10457 16 10 15.1046 10 14C10 12.8954 9.10457 12 8 12C6.89543 12 6 12.8954 6 14C6 15.1046 6.89543 16 8 16Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M16 16C17.1046 16 18 15.1046 18 14C18 12.8954 17.1046 12 16 12C14.8954 12 14 12.8954 14 14C14 15.1046 14.8954 16 16 16Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        Production / World
      </span>
      <h1>
        <span data-animate="heading" class="block text-5xl sm:text-6xl lg:text-7xl font-bold text-white leading-none tracking-tight" style="opacity: 1;"><span></span>Ths is the <span class="text-amber-400">Title</span></span>
      </h1>
      <p data-animate="text" class="mt-8 text-xl text-white/80 leading-relaxed" style="opacity: 1;">
        This is the Description for the post. Needs to be a couple of lines
      </p>
      <div data-motion="button" class="flex flex-wrap gap-4 mt-10" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
        <a href="#" class="px-8 py-4 bg-amber-600 hover:bg-amber-500 text-white font-semibold transition-colors">Watch on Youtube</a>
        <a href="#" class="px-8 py-4 bg-white/10 backdrop-blur-xs text-white font-semibold border border-white/30 hover:bg-white/20 transition-colors">Listen on Spotify</a>
      </div>
    </div>
  </div>
</section>
<section class="pt-10 max-w-7xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 pb-8 border-b border-slate-200 dark:border-neutral-800">
        <div data-motion="author" class="flex items-center gap-4" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
            <div class="w-12 h-12 rounded-full overflow-hidden">
                <img data-motion="image" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&amp;auto=format&amp;fit=crop&amp;q=80" alt="Dr. Sarah Mitchell" class="w-full h-full object-cover" style="opacity: 1; transform: scale(1); filter: blur(0px);">
            </div>
            <div>
                <p class="text-slate-900 dark:text-white font-semibold">Dr. Sarah Mitchell</p>
                <p class="text-slate-500 dark:text-neutral-400 text-sm">AI Research Lead · Jan 6, 2026</p>
            </div>
            </div>
            
            <div class="flex items-center gap-3">
            <span class="text-slate-500 dark:text-neutral-400 text-sm mr-2">Share</span>
            <a data-motion="social" href="#" class="w-9 h-9 rounded-full bg-slate-100 dark:bg-neutral-800 flex items-center justify-center text-slate-600 dark:text-neutral-400 hover:bg-amber-100 dark:hover:bg-amber-900/40 hover:text-amber-600 dark:hover:text-amber-400 transition-colors" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                </svg>
            </a>
            <a data-motion="social" href="#" class="w-9 h-9 rounded-full bg-slate-100 dark:bg-neutral-800 flex items-center justify-center text-slate-600 dark:text-neutral-400 hover:bg-amber-100 dark:hover:bg-amber-900/40 hover:text-amber-600 dark:hover:text-amber-400 transition-colors" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                </svg>
            </a>
            <a data-motion="social" href="#" class="w-9 h-9 rounded-full bg-slate-100 dark:bg-neutral-800 flex items-center justify-center text-slate-600 dark:text-neutral-400 hover:bg-amber-100 dark:hover:bg-amber-900/40 hover:text-amber-600 dark:hover:text-amber-400 transition-colors" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                </svg>
            </a>
        </div>
    </div>
</section>