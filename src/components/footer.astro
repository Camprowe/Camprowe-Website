---
import "../styles/global.css";
---

<footer id="_footer_logo_members_v6_001" class="bg-white dark:bg-neutral-950">
  <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="py-16 grid lg:grid-cols-12 gap-12 border-b border-slate-200 dark:border-neutral-800">
      
      <!-- Brand + Social Proof -->
      <div data-motion="brand" class="lg:col-span-4" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
        <a href="#" class="flex items-center mb-6">
          <img src="https://cdn.ln-cdn.com/image/placeholder-logo-full.png" ln-logo="" class="h-10" alt="Logo">
        </a>
        <p class="text-slate-600 dark:text-neutral-400 mb-8">Trusted by over 50,000 sellers worldwide. Join our growing community of successful entrepreneurs.</p>
        
        <!-- Social Proof -->
        <div data-motion="avatars" class="flex items-center gap-4" style="opacity: 1; transform: scale(1); filter: blur(0px);">
          <div class="flex -space-x-3">
            <img data-motion="avatar" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&amp;auto=format&amp;fit=crop&amp;q=80" alt="Member" class="w-10 h-10 rounded-full object-cover border-2 border-white dark:border-neutral-900" style="opacity: 1; transform: scale(1); filter: blur(0px);">
            <img data-motion="avatar" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&amp;auto=format&amp;fit=crop&amp;q=80" alt="Member" class="w-10 h-10 rounded-full object-cover border-2 border-white dark:border-neutral-900" style="opacity: 1; transform: scale(1); filter: blur(0px);">
            <img data-motion="avatar" src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&amp;auto=format&amp;fit=crop&amp;q=80" alt="Member" class="w-10 h-10 rounded-full object-cover border-2 border-white dark:border-neutral-900" style="opacity: 1; transform: scale(1); filter: blur(0px);">
            <div class="w-10 h-10 rounded-full bg-indigo-100 dark:bg-indigo-900/30 border-2 border-white dark:border-neutral-900 flex items-center justify-center">
              <span data-motion="badge" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">+5K</span>
            </div>
          </div>
          <div>
            <span class="text-slate-900 dark:text-white font-semibold">50K+</span>
            <span class="text-slate-500 dark:text-neutral-400 text-sm ml-1">Active Sellers</span>
          </div>
        </div>
      </div>

      <!-- Links Columns -->
      <div class="lg:col-span-8 grid sm:grid-cols-3 gap-8">
        <div data-motion="column" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
          <h4 class="text-slate-900 dark:text-white font-semibold mb-5">Marketplace</h4>
          <ul class="space-y-3">
            <li><a href="#" class="text-slate-600 dark:text-neutral-400 hover:text-indigo-500 transition-colors">Browse Products</a></li>
            <li><a href="#" class="text-slate-600 dark:text-neutral-400 hover:text-indigo-500 transition-colors">Categories</a></li>
            <li><a href="#" class="text-slate-600 dark:text-neutral-400 hover:text-indigo-500 transition-colors">Deals &amp; Offers</a></li>
            <li><a href="#" class="text-slate-600 dark:text-neutral-400 hover:text-indigo-500 transition-colors">New Arrivals</a></li>
          </ul>
        </div>
        <div data-motion="column" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
          <h4 class="text-slate-900 dark:text-white font-semibold mb-5">Sellers</h4>
          <ul class="space-y-3">
            <li><a href="#" class="text-slate-600 dark:text-neutral-400 hover:text-indigo-500 transition-colors">Start Selling</a></li>
            <li><a href="#" class="text-slate-600 dark:text-neutral-400 hover:text-indigo-500 transition-colors">Dashboard</a></li>
            <li><a href="#" class="text-slate-600 dark:text-neutral-400 hover:text-indigo-500 transition-colors">Analytics</a></li>
            <li><a href="#" class="text-slate-600 dark:text-neutral-400 hover:text-indigo-500 transition-colors">Academy</a></li>
          </ul>
        </div>
        <div data-motion="column" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
          <h4 class="text-slate-900 dark:text-white font-semibold mb-5">Support</h4>
          <ul class="space-y-3">
            <li><a href="#" class="text-slate-600 dark:text-neutral-400 hover:text-indigo-500 transition-colors">Help Center</a></li>
            <li><a href="#" class="text-slate-600 dark:text-neutral-400 hover:text-indigo-500 transition-colors">Contact Us</a></li>
            <li><a href="#" class="text-slate-600 dark:text-neutral-400 hover:text-indigo-500 transition-colors">Returns</a></li>
            <li><a href="#" class="text-slate-600 dark:text-neutral-400 hover:text-indigo-500 transition-colors">Shipping</a></li>
          </ul>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div data-motion="bottom" class="py-8 flex flex-col sm:flex-row items-center justify-between gap-6" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
      <p class="text-slate-500 text-sm">© 2026 ShopFlow. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="text-slate-500 hover:text-indigo-500 text-sm transition-colors">Terms</a>
        <a href="#" class="text-slate-500 hover:text-indigo-500 text-sm transition-colors">Privacy</a>
        <a href="#" class="text-slate-500 hover:text-indigo-500 text-sm transition-colors">Cookies</a>
      </div>
      <div class="flex items-center gap-3">
        <a href="#" class="w-9 h-9 flex items-center justify-center border border-slate-200 dark:border-neutral-700 rounded-full hover:bg-indigo-500 hover:border-indigo-500 hover:text-white text-slate-500 transition-all" aria-label="Twitter">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
          </svg>
        </a>
        <a href="#" class="w-9 h-9 flex items-center justify-center border border-slate-200 dark:border-neutral-700 rounded-full hover:bg-indigo-500 hover:border-indigo-500 hover:text-white text-slate-500 transition-all" aria-label="Instagram">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
          </svg>
        </a>
        <a href="#" class="w-9 h-9 flex items-center justify-center border border-slate-200 dark:border-neutral-700 rounded-full hover:bg-indigo-500 hover:border-indigo-500 hover:text-white text-slate-500 transition-all" aria-label="Facebook">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
          </svg>
        </a>
      </div>
    </div>

  </div>
</footer>