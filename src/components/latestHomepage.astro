        <a data-motion="button" href="#" class="inline-flex items-center gap-2 text-black font-semibold hover:gap-3 transition-all duration-300 opacity-0 group-hover:opacity-100" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
