<section id="_portfolio_bento_hover_v6_p5_001" class="py-10 sm:py-10 bg-white dark:bg-neutral-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Split Header -->
    <div data-motion="header" class="flex flex-col lg:flex-row items-start lg:items-end justify-between gap-6 mb-14" style="opacity: 1;">
        <div class="max-w-2xl">
            <span data-motion="badge" class="inline-flex items-center gap-2 px-4 bg-amber-100 dark:bg-amber-900/40 rounded-lg text-amber-600 dark:text-amber-400 text-sm font-medium mb-4" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">
