<section id="_portfolio_bento_hover_v6_p5_001" class="py-10 sm:py-10 bg-white dark:bg-neutral-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Split Header -->
    <div data-motion="header" class="flex flex-col lg:flex-row items-start lg:items-end justify-between gap-6 mb-14" style="opacity: 1;">
        <div class="max-w-2xl">
            <span data-motion="badge" class="text-amber-600 text-sm font-semibold tracking-wide uppercase mb-4 block" style="opacity: 1; transform: translateY(0px); filter: blur(0px);">Latest</span>
            <h2 class="text-4xl lg:text-5xl font-bold text-slate-900 dark:text-white mb-4">
